# ==== Cấu hình kết nối Odoo (ef.foxia.vn) ====
# URL gốc của Odoo, KHÔNG có dấu / ở cuối
ODOO_URL=https://ef.foxia.vn
# Tên database Odoo (xem tại /web/database/selector hoặc hỏi quản trị)
ODOO_DB=

# --- Cách 1 (khuyến nghị): đăng nhập bằng user + password/API key ---
ODOO_USERNAME=
# Có thể là mật khẩu hoặc API key (Settings > Account Security > API Keys)
ODOO_PASSWORD=

# --- Cách 2 (tùy chọn): dùng cookie session_id lấy từ trình duyệt ---
# Nếu điền, tool sẽ ưu tiên gọi JSON-RPC kèm cookie này thay vì đăng nhập lại.
# Lưu ý: session_id dễ hết hạn.
ODOO_SESSION_ID=

# Số lần thử lại khi lỗi mạng
ODOO_MAX_RETRIES=4
# Timeout mỗi request (giây)
ODOO_TIMEOUT=30

# ==== Auto-grab (nhận cơ hội) ====
# Id user đích để gán cơ hội. Bỏ trống = tài khoản đang đăng nhập.
ODOO_TARGET_UID=
