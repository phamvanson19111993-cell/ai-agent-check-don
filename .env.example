# ==== Cấu hình Pancake ====
# Lấy tại: Pancake -> Cấu hình -> Cấu hình ứng dụng -> Webhook & API Key
PANCAKE_ACCESS_TOKEN=dan_api_key_cua_ban_vao_day

# ID fanpage (lấy từ URL Pancake: https://pancake.vn/1121021804424838)
PANCAKE_PAGE_ID=1121021804424838

# Ten nhan "da chot don" (khong phan biet hoa thuong / dau tieng Viet).
# Nhieu nhan thi cach nhau bang dau phay.
PANCAKE_CLOSED_TAGS=CHỐT ĐƠN

# (Tuy chon) Doi base URL neu Pancake thay doi endpoint
# PANCAKE_API_BASE=https://pages.fm/api

# ==== Cau hinh Google Drive (tuy chon) ====
# Duong dan file credentials service account (.json) tai tu Google Cloud Console
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# ID thu muc Drive de luu file ket qua (lay tu URL thu muc)
# GDRIVE_FOLDER_ID=
