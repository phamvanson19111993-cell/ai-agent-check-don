# ================== BOT TELEGRAM ==================
# Token bot lấy từ @BotFather (bot: @dili_supplement_tr_bot)
# ⚠️ TỰ TAY điền token vào đây, KHÔNG gửi token cho ai.
BOT_TOKEN=

# Chat ID của NHÓM Telegram nhận báo cáo.
# Cách lấy: thêm bot vào nhóm → gõ /id trong nhóm → bot trả về số (thường bắt đầu bằng -100...)
REPORT_CHAT_ID=

# ================== NGUỒN DỮ LIỆU (Google Sheet) ==================
SOURCE_TYPE=csv

# Sheet "2026 Giàu sang phú quý !" — cần chia sẻ: Bất kỳ ai có link → Người xem.
# MỘT tab (tab đầu tiên):
CSV_URL=https://docs.google.com/spreadsheets/d/1CaCQZvLhAafJ42vuinOlwGhlGmPZCCSzPyzxmlIFNyE/export?format=csv

# NHIỀU tab: dùng CSV_URLS, mỗi tab một dòng dạng "Tên tab|link", ngăn cách bằng dấu ;
# Lấy gid: mở tab đó trên trình duyệt, nhìn cuối URL có #gid=123456 → thay vào &gid=
# Ví dụ (bỏ dấu # ở đầu để dùng):
#CSV_URLS=Tháng 1|https://docs.google.com/spreadsheets/d/1CaCQZvLhAafJ42vuinOlwGhlGmPZCCSzPyzxmlIFNyE/export?format=csv&gid=0;Tháng 2|https://docs.google.com/spreadsheets/d/1CaCQZvLhAafJ42vuinOlwGhlGmPZCCSzPyzxmlIFNyE/export?format=csv&gid=123456789

# Tên cột trong Sheet (có thể liệt kê nhiều tên, phân cách dấu phẩy — bot tự dò)
COL_PHONE=SĐT,SDT,SỐ ĐIỆN THOẠI
COL_CUSTOMER=KHÁCH HÀNG
COL_DATE=Ngày
COL_PRODUCT=SẢN PHẨM
COL_STATUS=trạng thái

# ================== CỔNG HTTP NHẬN SỐ (cho userscript Tampermonkey) ==================
INTAKE_HOST=127.0.0.1
INTAKE_PORT=8787
# Chuỗi bí mật tuỳ ý (đặt dài, khó đoán). Phải điền GIỐNG HỆT trong userscript.
# Để trống = tắt cổng HTTP.
INTAKE_SECRET=doi-mat-khau-nay-ngay

# ================== ĐỘ TIN CẬY ==================
# Nhịp tim: gửi "bot vẫn chạy" mỗi N giờ lên nhóm (0 = tắt)
HEARTBEAT_HOURS=0
# Tự nạp lại Sheet mỗi N phút
RELOAD_MINUTES=15
# Không báo lại cùng một số trong N phút (tránh spam khi Messenger gửi lặp)
DEDUP_TTL_MIN=10

# Múi giờ hiển thị trên báo cáo
TZ_NAME=Asia/Ho_Chi_Minh
