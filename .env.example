# ---- Zalo Official Account ----
# Lay tai https://developers.zalo.me (App > Official Account API)
ZALO_APP_ID=
ZALO_APP_SECRET=
# Secret key dung de ky webhook (thuong trung ZALO_APP_SECRET; neu OA co
# "OA Secret Key" rieng thi dien vao day)
ZALO_OA_SECRET_KEY=
# Refresh token lay tu buoc OAuth cap quyen OA (chi dung mot lan, app se tu
# luu token moi vao ZALO_TOKEN_FILE)
ZALO_REFRESH_TOKEN=
ZALO_TOKEN_FILE=./data/zalo-token.json
# Dat false chi khi test cuc bo (bo qua kiem tra chu ky webhook)
ZALO_VERIFY_SIGNATURE=true

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — low cho toc do tra loi chat
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=16000
CLAUDE_MAX_TOOL_TURNS=6

# ---- Nguon du lieu don hang ----
# mock = doc file JSON | http = goi API cua ban
ORDER_PROVIDER=mock
ORDER_MOCK_FILE=./data/orders.json
ORDER_API_BASE_URL=
ORDER_API_KEY=
ORDER_API_TIMEOUT_MS=8000

# ---- Server ----
PORT=3000
LOG_LEVEL=info
SESSION_MAX_TURNS=12
SESSION_TTL_MS=1800000
